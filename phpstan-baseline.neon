parameters:
	ignoreErrors:
		-
			message: '#^Anonymous function should return array\{category\: \(int\|string\), category_name\: \(int\|string\), badges\: Illuminate\\Support\\Collection\<int, array\{id\: int, key\: string, name\: string, description\: string, icon\: string\|null, image_url\: string\|null, tier\: string, points\: int, \.\.\.\}\>, total_in_category\: int\<0, max\>, earned_in_category\: int\<0, max\>\} but returns array\{category\: \(int\|string\), category_name\: \(int\|string\), badges\: Illuminate\\Support\\Collection\<int, array\{id\: int, key\: string, name\: string, description\: string, icon\: string\|null, image_url\: string\|null, tier\: string, points\: int, \.\.\.\}\>, total_in_category\: int\<0, max\>, earned_in_category\: int\<0, max\>\}\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/Api/BadgeController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection\<\(int\|string\),Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\Badge\>\>\:\:map\(\) expects callable\(Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\Badge\>, int\|string\)\: array\{category\: int\|string, category_name\: int\|string, badges\: Illuminate\\Support\\Collection\<int, array\{id\: int, key\: string, name\: string, description\: string, icon\: string\|null, image_url\: string\|null, tier\: string, points\: int, earned\: bool, earned_at\: string\|null, times_earned\: int\}\>, total_in_category\: int\<0, max\>, earned_in_category\: int\<0, max\>\}, Closure\(mixed, mixed\)\: array\{category\: int\|string, category_name\: int\|string, badges\: Illuminate\\Support\\Collection\<int, array\{id\: int, key\: string, name\: string, description\: string, icon\: string\|null, image_url\: string\|null, tier\: string, points\: int, earned\: bool, earned_at\: string\|null, times_earned\: int\}\>, total_in_category\: int\<0, max\>, earned_in_category\: int\<0, max\>\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Api/BadgeController.php

		-
			message: '#^Using nullsafe property access "\?\-\>tier_level" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Api/BadgeController.php

