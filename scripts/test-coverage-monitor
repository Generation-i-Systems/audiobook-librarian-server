#!/bin/bash

# Test Coverage Reporter for Audiobook Librarian
# Generates comprehensive coverage reports and statistics

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration
COVERAGE_DIR="coverage"
REPORT_DIR="coverage-reports"
PHPUNIT_CONFIG="phpunit.xml"
JEST_CONFIG="jest.config.js"

# Ensure directories exist
mkdir -p "$COVERAGE_DIR" "$REPORT_DIR"

echo -e "${BLUE}📊 Generating Test Coverage Reports${NC}"

# Generate PHP coverage
echo -e "${YELLOW}Running PHP Tests...${NC}"
XDEBUG_MODE=coverage ./vendor/bin/phpunit --configuration="$PHPUNIT_CONFIG" --coverage-text --coverage-clover=coverage.xml

# Generate JavaScript coverage
echo -e "${YELLOW}Running JavaScript Tests...${NC}"
npx jest --config="$JEST_CONFIG" --coverage --coverageReporters=text-lcov --coverageReporters=html

# Process PHP coverage
if [ -f "coverage.xml" ]; then
    echo -e "${GREEN}✓ PHP coverage generated${NC}"
    
    # Extract key metrics from PHP coverage
    PHP_LINES=$(grep -o "lines validated=" coverage.xml | sed 's/.*lines validated="\([0-9.]*\)".*/\1/' | head -1)
    PHP_METHODS=$(grep -o "methods=" coverage.xml | sed 's/.*methods="\([0-9.]*\)".*/\1/' | head -1)
    PHP_CLASSES=$(grep -o "classes=" coverage.xml | sed 's/.*classes="\([0-9.]*\)".*/\1/' | head -1)
    
    # Generate PHP coverage report
    cat > "$REPORT_DIR/php-coverage.txt" << EOF
PHP Test Coverage Report
==================
Lines Covered: $PHP_LINES%
Methods Covered: $PHP_METHODS%
Classes Covered: $PHP_CLASSES%

Last Updated: $(date)
EOF
else
    echo -e "${RED}✗ PHP coverage file not found${NC}"
fi

# Process JavaScript coverage
if [ -f "coverage/lcov.info" ]; then
    echo -e "${GREEN}✓ JavaScript coverage generated${NC}"
    
    # Extract key metrics from JS coverage
    JS_LINES=$(npx npx coverage summary coverage/lcov.info | grep "Lines" | awk '{print $2}')
    JS_FUNCTIONS=$(npx npx coverage summary coverage/lcov.info | grep "Functions" | awk '{print $2}')
    JS_BRANCHES=$(npx npx coverage summary coverage/lcov.info | grep "Branches" | awk '{print $2}')
    
    # Generate JavaScript coverage report
    cat > "$REPORT_DIR/js-coverage.txt" << EOF
JavaScript Test Coverage Report
========================
Lines Covered: $JS_LINES%
Functions Covered: $JS_FUNCTIONS%
Branches Covered: $JS_BRANCHES%

Last Updated: $(date)
EOF
else
    echo -e "${RED}✗ JavaScript coverage file not found${NC}"
fi

# Generate HTML combined report
if [ -f "coverage.xml" ] && [ -f "coverage/lcov.info" ]; then
    echo -e "${YELLOW}Generating combined HTML report...${NC}"
    
    cat > "$REPORT_DIR/coverage-summary.html" << EOF
<!DOCTYPE html>
<html>
<head>
    <title>Audiobook Librarian - Test Coverage Report</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #f5f5f5; }
        .header { background: #2c3e50; color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
        .metric { background: white; padding: 15px; border-radius: 6px; text-align: center; }
        .metric h3 { margin: 0 0 10px 0; color: #333; }
        .metric .value { font-size: 24px; font-weight: bold; color: #2c3e50; }
        .metric .label { font-size: 14px; color: #666; margin-top: 5px; }
        .good { background: #d4edda; }
        .warning { background: #fff3cd; }
        .poor { background: #f8d7da; }
        .timestamp { text-align: right; font-size: 12px; color: #666; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>📊 Audiobook Librarian - Test Coverage Report</h1>
        <p class="timestamp">Generated on $(date)</p>
    </div>
    
    <div class="metrics">
        <div class="metric">
            <h3>PHP Coverage</h3>
            <div class="value ${GREEN}good${NC}">$PHP_LINES%</div>
            <div class="label">Lines</div>
        </div>
        
        <div class="metric">
            <h3>JavaScript Coverage</h3>
            <div class="value ${GREEN}good${NC}">$JS_LINES%</div>
            <div class="label">Lines</div>
        </div>
        
        <div class="metric">
            <h3>PHP Methods</h3>
            <div class="value ${GREEN}good${NC}">$PHP_METHODS%</div>
            <div class="label">Methods</div>
        </div>
        
        <div class="metric">
            <h3>JavaScript Functions</h3>
            <div class="value ${GREEN}good${NC}">$JS_FUNCTIONS%</div>
            <div class="label">Functions</div>
        </div>
        
        <div class="metric">
            <h3>PHP Classes</h3>
            <div class="value ${GREEN}good${NC}">$PHP_CLASSES%</div>
            <div class="label">Classes</div>
        </div>
        
        <div class="metric">
            <h3>JavaScript Branches</h3>
            <div class="value ${GREEN}good${NC}">$JS_BRANCHES%</div>
            <div class="label">Branches</div>
        </div>
    </div>
    
    <div class="timestamp">Report generated by test-coverage-monitor</div>
</body>
</html>
EOF
    
    echo -e "${GREEN}✓ Combined HTML report generated${NC}"
else
    echo -e "${RED}✗ Could not generate combined report - missing coverage files${NC}"
fi

# Generate trend tracking
echo "$PHP_LINES,$JS_LINES,$PHP_METHODS,$JS_FUNCTIONS,$PHP_CLASSES,$JS_BRANCHES,$(date +%s)" >> "$REPORT_DIR/coverage-trends.csv"

echo -e "${GREEN}📊 Test coverage reports generated successfully!${NC}"
echo -e "${BLUE}View reports:${NC}"
echo -e "  - Text reports: $REPORT_DIR/"
echo -e "  - HTML report: $REPORT_DIR/coverage-summary.html"
echo -e "  - Trends: $REPORT_DIR/coverage-trends.csv"