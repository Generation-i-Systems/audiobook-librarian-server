#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Pre-commit checks...${NC}"
echo ""

# Get list of changed files (staged files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 0. Syntax check for PHP and JS files
echo -e "${YELLOW}✅ Checking syntax for PHP and JS files...${NC}"
SYNTAX_CHECKED=false
for file in $STAGED_FILES; do
    if [ ! -f "$file" ]; then
        continue
    fi
    if [[ $file == *.php ]]; then
        if ! php -l "$file" > /dev/null 2>&1; then
            echo -e "${RED}❌ PHP syntax error in $file${NC}"
            php -l "$file"
            exit 1
        fi
        SYNTAX_CHECKED=true
    elif [[ $file == *.js ]]; then
        if ! node --check "$file" > /dev/null 2>&1; then
            echo -e "${RED}❌ JS syntax error in $file${NC}"
            node --check "$file"
            exit 1
        fi
        SYNTAX_CHECKED=true
    fi
done

if [ "$SYNTAX_CHECKED" = true ]; then
    echo -e "${GREEN}✅ Syntax check passed${NC}"
    echo ""
fi

# Check if any PHP files are staged for remaining PHP-specific tools
PHP_STAGED=false
PHP_FILES=()
for file in $STAGED_FILES; do
    if [[ $file == *.php ]]; then
        PHP_STAGED=true
        PHP_FILES+=("$file")
    fi
done

# If no PHP files staged, we are done
if [ "$PHP_STAGED" = false ]; then
    echo -e "${GREEN}✅ All checks passed${NC}"
    exit 0
fi

# 1. Run Pint on changed files
echo -e "${YELLOW}🎨 Running Pint on staged PHP files...${NC}"
if ./vendor/bin/pint --config .pint.json --test "${PHP_FILES[@]}" 2>&1; then
    echo -e "${GREEN}✅ Pint passed${NC}"
else
    echo -e "${RED}❌ Pint failed${NC}"
    echo -e "${YELLOW}Run: ./vendor/bin/pint --config .pint.json ${PHP_FILES[@]} to fix${NC}"
    exit 1
fi
echo ""

# 2. Run PHPStan on app directory (full check for global consistency)
echo -e "${YELLOW}🔍 Running PHPStan on app directory...${NC}"
# Use PIPESTATUS to catch the exit code of PHPStan, not tee
./vendor/bin/phpstan analyse --memory-limit=2G --no-progress 2>&1 | tee /tmp/phpstan-output.txt
PHPSTAN_EXIT_CODE=${PIPESTATUS[0]}

if [ $PHPSTAN_EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}✅ PHPStan passed${NC}"
else
    echo -e "${RED}❌ PHPStan failed with exit code $PHPSTAN_EXIT_CODE${NC}"
    exit 1
fi
echo ""

# 3. Quick smoke test or specific tests based on changes
echo -e "${YELLOW}🧪 Running tests...${NC}"
IMPORT_CHANGED=false
TESTS_TO_RUN=""

for file in "${PHP_FILES[@]}"; do
    case $file in
        tests/Import/*)
            IMPORT_CHANGED=true
            ;;
        tests/Web/*)
            if [[ ! $TESTS_TO_RUN =~ "tests/Web" ]]; then
                TESTS_TO_RUN="${TESTS_TO_RUN} tests/Web"
            fi
            ;;
        tests/Api/*)
            if [[ ! $TESTS_TO_RUN =~ "tests/Api" ]]; then
                TESTS_TO_RUN="${TESTS_TO_RUN} tests/Api"
            fi
            ;;
        tests/Cli/*)
            if [[ ! $TESTS_TO_RUN =~ "tests/Cli" ]]; then
                TESTS_TO_RUN="${TESTS_TO_RUN} tests/Cli"
            fi
            ;;
    esac
done

if [ "$IMPORT_CHANGED" = true ]; then
    echo -e "${YELLOW}Running import regression tests...${NC}"
    php artisan test tests/Import --stop-on-failure
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Import tests FAILED${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Import tests passed${NC}"
elif [ -n "$TESTS_TO_RUN" ]; then
    echo -e "${YELLOW}Running: ${TESTS_TO_RUN}${NC}"
    php artisan test ${TESTS_TO_RUN} --stop-on-failure
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Tests FAILED${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Tests passed${NC}"
else
    echo -e "${YELLOW}Running smoke test...${NC}"
    php artisan test --filter=EndpointSmokeTest --stop-on-failure
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Smoke test FAILED${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Smoke test passed${NC}"
fi
echo ""

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo -e "${BLUE}🚀 Proceeding with commit...${NC}"
exit 0
