/**
 * Retrieves a list of unique authors from the 'books' collection in
Firestore.
 *
  * @param {!express:Request} req Express.js HTTP Request.
   * @param {!express:Response} res Express.js HTTP Response.
    */
	const functions = require('firebase-functions');
	const admin = require('firebase-admin');
	admin.initializeApp();
	
	exports.getUniqueAuthors = functions.https.onRequest(async (req,
res) => {
  try {
      const db = admin.firestore();
	      const booksSnapshot = await db.collection('books').get();
		  
		      if (booksSnapshot.empty) {
			        console.log('No books found.');
					      res.status(200).send([]);
						        return;
								    }
									
									    const allAuthors = new Set();
										
										    booksSnapshot.forEach(doc
=> {
      const bookData = doc.data();
	        if (bookData && Array.isArray(bookData.author)) {
			        bookData.author.forEach(author => {
					          if (typeof author === 'string' &&
author.trim() !== '') {
            allAuthors.add(author.trim());
			          }
					          });
							        }
									    });
										
										    const uniqueAuthors = Array.from(allAuthors).sort();
											
											    console.log('Unique
authors:', uniqueAuthors);
    res.status(200).send(uniqueAuthors);
	
