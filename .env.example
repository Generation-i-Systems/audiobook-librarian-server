# .env.example — environment configuration template
# Copy this file to .env and fill in your values.
# .env is NOT committed to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

APP_NAME="Audiobook Librarian"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_CHANNEL=single
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — primary (MySQL)
# ---------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ab_librarian
DB_USERNAME=root
DB_PASSWORD=

# Document store driver: 'mysql' or 'mongodb'
DOCUMENT_STORE_DRIVER=mysql

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Broadcasting / Queues / Cache
# ---------------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Memcached (optional, used when CACHE_STORE=memcached)
# ---------------------------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Mail
# Use MAIL_MAILER=log for local development (emails are written to the log).
# For production consider smtp, ses, or mailgun.
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Amazon SES SMTP credentials (used when MAIL_MAILER=smtp with SES host)
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=

# ---------------------------------------------------------------------------
# AWS / S3 (optional, used when FILESYSTEM_DISK=s3)
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# MongoDB (optional, used when DOCUMENT_STORE_DRIVER=mongodb)
# ---------------------------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ab_librarian

# ---------------------------------------------------------------------------
# Book Storage
# ---------------------------------------------------------------------------

# Absolute path where downloaded audiobooks are stored
BOOK_STORAGE_PATH=/media/audiobooks/books

# Trash / deleted books
DELETED_BOOKS_PATH=/media/audiobooks/trash
TRASH_AUTO_CLEANUP_DAYS=90

# ---------------------------------------------------------------------------
# Library Profiles (host-based routing)
# Comma-separated hostnames for each profile.
# ---------------------------------------------------------------------------

LIBRARY_PROFILE_MAIN_HOSTS=localhost,127.0.0.1
LIBRARY_PROFILE_LIBRIVOX_HOSTS=

# Database connection name for the librivox profile (must match a key in config/database.php).
# Leave blank to disable profile DB switching.
LIBRARY_PROFILE_LIBRIVOX_DB_CONNECTION=librivox

# Storage root for librivox downloaded/cached files
LIBRARY_PROFILE_LIBRIVOX_BOOK_STORAGE_PATH=/media/audiobooks/librivox

# LibriVox database connection (used when LIBRARY_PROFILE_LIBRIVOX_DB_CONNECTION=librivox)
DB_LIBRIVOX_HOST=127.0.0.1
DB_LIBRIVOX_PORT=3306
DB_LIBRIVOX_DATABASE=librarian_librivox
DB_LIBRIVOX_USERNAME=root
DB_LIBRIVOX_PASSWORD=

# ---------------------------------------------------------------------------
# Skins
# ---------------------------------------------------------------------------

# Comma-separated list of directories to search for skins.
# Supports both .zip files and extracted directories.
# Example: /path/to/client/skins,/path/to/beta/skins
SKIN_PATHS=

# Path to client repository src-skins directory (for built-in skins browsing/forking/admin editing)
# Example: /path/to/audiobook-librarian-client/composeApp/src-skins
CLIENT_SKINS_PATH=

# ---------------------------------------------------------------------------
# Google OAuth (Socialite)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# The web client is used for server-side OAuth; Android clients validate tokens
# sent from the mobile app.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Android OAuth client IDs (used for token validation, no secret needed)
GOOGLE_CLIENT_ID_ANDROID_LIBRARY=
GOOGLE_CLIENT_ID_ANDROID_PLAYER=
GOOGLE_CLIENT_ID_ANDROID_LIBRARY_DEV=
GOOGLE_CLIENT_ID_ANDROID_PLAYER_DEV=

# ---------------------------------------------------------------------------
# Discord OAuth (Socialite)
# Create an application at: https://discord.com/developers/applications
# ---------------------------------------------------------------------------

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=ablibrarian://auth/discord

# ---------------------------------------------------------------------------
# Facebook OAuth (Socialite) — optional
# ---------------------------------------------------------------------------

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Apple Sign-In (Socialite) — optional
# ---------------------------------------------------------------------------

APPLE_CLIENT_ID=
APPLE_CLIENT_ID_IOS=
APPLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Google Books API
# Used for book metadata lookups.
# Get a key at: https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------

GOOGLE_BOOKS_API_KEY=

# ---------------------------------------------------------------------------
# Hardcover API (optional)
# Get a token at: https://hardcover.app/account/api
# ---------------------------------------------------------------------------

HARDCOVER_API_KEY=

# ---------------------------------------------------------------------------
# AudiobookBay scraping (optional)
# ---------------------------------------------------------------------------

AUDIOBOOK_BAY_BASE_URL=https://audiobookbay.lu
AUDIOBOOK_BAY_USERNAME=
AUDIOBOOK_BAY_PASSWORD=
AUDIOBOOK_BAY_RATE_LIMIT=100

# ---------------------------------------------------------------------------
# AI — metadata enrichment
# Choose default provider: 'gemini', 'claude', or 'openai'
# ---------------------------------------------------------------------------

AI_DEFAULT_PROVIDER=gemini

# Gemini (Google)
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Model options: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-2.5-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
# Timeout in seconds for API requests
GEMINI_TIMEOUT=30
# Set to true if you have billing enabled on your Google Cloud account
GEMINI_PAID_TIER=false

# Claude (Anthropic)
# Get API key from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
# Model options: claude-3.5-haiku, claude-3.5-sonnet, claude-3.5-opus
CLAUDE_MODEL=claude-3.5-sonnet
CLAUDE_PAID_TIER=true

# OpenAI
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
# Timeout in seconds for API requests
OPENAI_TIMEOUT=30
# Optional: your OpenAI organization ID
OPENAI_ORGANIZATION=
