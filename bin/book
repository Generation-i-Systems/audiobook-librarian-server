#!/usr/bin/env bash

# Book Info - Quick wrapper for books:show command
# This script can be symlinked to a common bin directory for easy access

# Save the original working directory before any cd commands
ORIGINAL_DIR="$(pwd)"

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Find the Laravel project root (parent of bin directory)
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Separate directory arguments from options and resolve paths
DIRS=()
OPTS=()
for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
        OPTS+=("$arg")
    else
        # Resolve relative paths to absolute paths before cd
        if [[ "$arg" == /* ]]; then
            # Already absolute
            DIRS+=("$arg")
        else
            # Relative path - resolve it now
            RESOLVED_PATH="$(cd "$ORIGINAL_DIR" && cd "$arg" 2>/dev/null && pwd)"
            if [ -n "$RESOLVED_PATH" ]; then
                DIRS+=("$RESOLVED_PATH")
            else
                DIRS+=("$arg")
            fi
        fi
    fi
done

# Change to project directory
cd "$PROJECT_ROOT" || exit 1

# If no directory arguments provided, use the saved original working directory
if [ ${#DIRS[@]} -eq 0 ]; then
    php artisan books:show "$ORIGINAL_DIR" "${OPTS[@]}"
else
    # Pass resolved directory arguments and options to the artisan command
    php artisan books:show "${DIRS[@]}" "${OPTS[@]}"
fi
