#!/usr/bin/env bash

# Book Info - Quick wrapper for books:show command
# This script can be symlinked to a common bin directory for easy access

# Save the original working directory before any cd commands
ORIGINAL_DIR="$(pwd)"

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Find the Laravel project root (parent of bin directory)
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Separate directory arguments from options and resolve paths
DIRS=()
OPTS=()
EXPECTING_VALUE=false
for arg in "$@"; do
    if [[ "$EXPECTING_VALUE" == true ]]; then
        # This is a value for the previous option
        OPTS+=("$arg")
        EXPECTING_VALUE=false
    elif [[ "$arg" == -* ]]; then
        OPTS+=("$arg")
        # Check if this option expects a value (has = or is a short flag without =)
        if [[ "$arg" == --*=* ]] || [[ "$arg" == -[a-zA-Z] ]]; then
            # Long option with = has value inline, or short option might have separate value
            if [[ "$arg" == -[a-zA-Z] ]]; then
                EXPECTING_VALUE=true
            fi
        fi
    else
        # This is a directory argument (not preceded by an option flag)
        # Resolve relative paths to absolute paths before cd
        if [[ "$arg" == /* ]]; then
            # Already absolute
            DIRS+=("$arg")
        else
            # Try to resolve as relative to current directory first
            RESOLVED_PATH="$(cd "$ORIGINAL_DIR" && cd "$arg" 2>/dev/null && pwd)"
            if [ -n "$RESOLVED_PATH" ]; then
                DIRS+=("$RESOLVED_PATH")
            else
                # Can't resolve from current dir - pass as-is and let PHP handle it
                # (might be relative to book root)
                DIRS+=("$arg")
            fi
        fi
    fi
done

# Change to project directory
cd "$PROJECT_ROOT" || exit 1

# Export shell CWD so PHP can resolve relative paths in options
export SHELL_CWD="$ORIGINAL_DIR"

# If no directory arguments provided, use the saved original working directory
if [ ${#DIRS[@]} -eq 0 ]; then
    php artisan books:info "$ORIGINAL_DIR" "${OPTS[@]}"
else
    # Pass resolved directory arguments and options to the artisan command
    php artisan books:info "${DIRS[@]}" "${OPTS[@]}"
fi
