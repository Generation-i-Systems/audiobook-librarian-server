# .env.docker.example — environment template for `docker compose up`
# Copy to .env.docker and adjust as needed:
#   cp .env.docker.example .env.docker
#
# Defaults here are tuned for a zero-config demo: SQLite database, file
# cache/session/queue, no external services required. See docker/README.md
# for how to switch to MySQL + Redis instead.

APP_NAME="Audiobook Librarian"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---------------------------------------------------------------------------
# Database — SQLite by default (file lives on the `app-storage` volume).
# To use MySQL instead, see docker/README.md and docker-compose.mysql.yml.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DOCUMENT_STORE_DRIVER=mysql

# Only used when layering docker-compose.mysql.yml or docker-compose.pgsql.yml
# on top of the base stack (ignored for the default SQLite setup). DB_NAME is
# deliberately a separate variable from DB_DATABASE above, which holds the
# SQLite file path — reusing DB_DATABASE here would name the MySQL/Postgres
# database after that file path.
DB_NAME=ab_librarian
DB_USERNAME=ablibrarian
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Host port to publish the app on, and host directories to bind-mount for
# book storage (used by docker-compose.yml's ${...} substitutions):
APP_PORT=8080
HOST_BOOK_STORAGE_PATH=./docker-data/books
HOST_DELETED_BOOKS_PATH=./docker-data/trash

# ---------------------------------------------------------------------------
# Session / Cache / Queue — file & database drivers need no extra services.
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Book storage — bind-mounted host directories (see docker-compose.yml).
# ---------------------------------------------------------------------------
BOOK_STORAGE_PATH=/data/books
DELETED_BOOKS_PATH=/data/trash
TRASH_AUTO_CLEANUP_DAYS=90

# ---------------------------------------------------------------------------
# Migrations run automatically on container start (non-destructive: only
# applies pending migrations, never drops/truncates). Set to false to skip.
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Optional integrations — fill in as needed, all safe to leave blank.
# ---------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
GOOGLE_BOOKS_API_KEY=
HARDCOVER_API_KEY=

MAIL_MAILER=log
