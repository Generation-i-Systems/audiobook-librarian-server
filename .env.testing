APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BOOK_STORAGE_PATH=/tmp
DELETED_BOOKS_PATH=/tmp
LOG_CHANNEL=testing
LOG_LEVEL=debug

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Force SQLite for all test operations
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

AUDIOBOOK_BAY_USERNAME=
AUDIOBOOK_BAY_PASSWORD=
AUDIOBOOK_BAY_BASE_URL=https://audiobookbay.invalid
AUDIOBOOK_BAY_RATE_LIMIT=100

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ab_librarian

# Firebase support removed - application now uses SQLite only
DOCUMENT_STORE_DRIVER=sqlite

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_CREDENTIALS=

# External Service Keys (Dummy values for tests)
GOOGLE_BOOKS_API_KEY=dummy-key
GEMINI_API_KEY=dummy-key
CLAUDE_API_KEY=dummy-key
OPENAI_API_KEY=dummy-key

#XDEBUG_MODE=coverage
PULSE_ENABLED=false
DEBUGBAR_ENABLED=false
