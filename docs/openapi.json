    "/notifications/register": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Register for push notifications",
        "description": "Register a device token for push notifications",
        "operationId": "registerForNotifications",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_token": {
                    "type": "string",
                    "description": "Device token for push notifications"
                  },
                  "device_type": {
                    "type": "string",
                    "enum": [
                      "ios",
                      "android",
                      "web"
                    ],
                    "description": "Device type"
                  }
                },
                "required": [
                  "device_token",
                  "device_type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device registered for notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Device registered for notifications"
                    },
                    "device_id": {
                      "type": "string",
                      "description": "Device ID for reference"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
